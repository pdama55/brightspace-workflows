# ---- Primary data source: your Brightspace iCal subscription ----
# In Brightspace: Calendar -> Settings -> tick "Enable Calendar Feeds" -> Save,
# then a "Subscribe" button appears -> copy the URL.
# Subscribe to ALL calendars for one line, or list one line per course.
# Optional "LABEL=" prefix names the course for events that don't name their own.
# For MULTIPLE feeds, wrap the whole value in double quotes, one per line —
# .env silently drops unquoted continuation lines.
BRIGHTSPACE_ICAL_URLS=webcal://your-school.brightspace.com/d2l/le/calendar/feed/user/feed.ics?token=...

# ---- Digest behavior ----
TIMEZONE=America/New_York      # blank = your machine's local timezone
LOOKAHEAD_DAYS=7               # how far ahead to list assignments
SEND_AT=07:30                  # local time of the daily digest
POLL_INTERVAL_SECONDS=1800     # how often the loop wakes up
ALERT_ON_CHANGE=true           # re-text if something new appears after the daily digest
SEND_WHEN_EMPTY=true           # still text on a day with nothing due

# ---- SMS ----
DRY_RUN=true                   # true = print to the terminal instead of texting
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15551234567
TWILIO_TO_NUMBER=+15557654321

# ---- Syllabus parsing (only needed for `parse-syllabus`) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ---- Grades + submission status (session cookie) ----
# Your whole browser `cookie:` request header, in double quotes. Expires
# periodically; `python app.py probe` tells you when to re-paste it.
BRIGHTSPACE_BASE_URL=https://your-school.brightspace.com
BRIGHTSPACE_COOKIE=""

# ---- Optional: Brightspace REST API (OAuth, needs an admin) ----
# Only works if an admin registers an OAuth app for you
# (Admin Tools -> Manage Extensibility -> OAuth 2.0 -> Register an app).
# The digest does NOT need any of this.
BRIGHTSPACE_CLIENT_ID=
BRIGHTSPACE_CLIENT_SECRET=
BRIGHTSPACE_REFRESH_TOKEN=
BRIGHTSPACE_ACCESS_TOKEN=
